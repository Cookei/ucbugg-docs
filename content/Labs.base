views:
  - type: cards
    name: All
    filters:
      and:
        - file.hasTag("lab")
    order:
      - file.name
    image: note.image
  - type: cards
    name: Pre-Production
    filters:
      and:
        - file.hasTag("lab", "pre-production")
    order:
      - file.name
    image: note.image
    imageAspectRatio: 1
  - type: cards
    name: Modeling
    filters:
      and:
        - file.hasTag("lab", "modeling")
    image: note.image
