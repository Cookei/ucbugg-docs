views:
  - type: cards
    name: All
    filters:
      and:
        - file.hasTag("lab")
        - file.folder != "templates"
    order:
      - file.name
    image: note.image
  - type: cards
    name: Pre-Production
    filters:
      and:
        - file.hasTag("lab")
        - file.hasTag("pre-production")
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
    image: note.image
    imageAspectRatio: 1
  - type: cards
    name: Modeling
    filters:
      and:
        - file.hasTag("lab")
        - file.hasTag("modeling")
    sort:
      - property: file.name
        direction: ASC
    image: note.image
